<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- ImplicitUsings desligado de propósito: ele importaria System.Linq, e o projeto não pode usar LINQ (RF09). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MiniBanco.ConsoleApp</RootNamespace>
  </PropertyGroup>

</Project>
